    { "Prodati %s pijaci za $%d?\nPijaca ce ga dalje prodavati za $%d.", "Sell the %s to the market for $%d?\nThe market will resell it for $%d.", "Продать %s рынку за $%d?\nРынок будет продавать её за $%d.", "Vender el %s al mercado por $%d?\nEl mercado lo revendera por $%d.", "%s pazara $%d karsiliginda satilsin mi?\nPazar onu $%d fiyatla satacak." },
    { "Auto pijaca", "Used car market", "Авторынок", "Mercado de usados", "Ikinci el pazari" },
    { "Ne mozete primiti toliko novca.", "You can't receive that much money.", "Вы не можете получить столько денег.", "No puedes recibir tanto dinero.", "Bu kadar para alamazsiniz." },
    { "Prodali ste %s za $%d. Pijaca je puna, pa je vozilo otislo na otpad.", "You sold the %s for $%d. The market is full, so the car went to the scrapyard.", "Вы продали %s за $%d. Рынок полон, машина ушла на свалку.", "Vendiste el %s por $%d. El mercado esta lleno, asi que fue al desguace.", "%s aracini $%d karsiliginda sattiniz. Pazar dolu oldugu icin arac hurdaya gitti." },
    { "Prodali ste %s pijaci za $%d.", "You sold the %s to the market for $%d.", "Вы продали %s рынку за $%d.", "Vendiste el %s al mercado por $%d.", "%s aracini pazara $%d karsiliginda sattiniz." },
    { "Kupili ste %s za $%d. Odvezite ga s pijace i parkirajte s /parkiraj.", "You bought the %s for $%d. Drive it off the market and park it with /park.", "Вы купили %s за $%d. Уезжайте с рынка и паркуйтесь через /park.", "Compraste el %s por $%d. Sacalo del mercado y aparcalo con /park.", "%s aracini $%d karsiliginda aldiniz. Pazardan cikarip /park ile park edin." },
    { "Auto pijaca (%d/%d mjesta)", "Used car market (%d/%d spots)", "Авторынок (%d/%d мест)", "Mercado de usados (%d/%d plazas)", "Ikinci el pazari (%d/%d yer)" },
    { "Postavi mjesto otkupa ovdje\nDodaj parking mjesto ovdje (vozilo u kojem sjedite ili vasa pozicija)\nUkloni najblize parking mjesto\nPostavi prodavaca ovdje\nUkloni prodavaca", "Set the buy-in point here\nAdd a parking spot here (the vehicle you sit in, or your position)\nRemove the nearest parking spot\nPlace the seller here\nRemove the seller", "Поставить точку выкупа здесь\nДобавить парковочное место здесь (ваша машина или позиция)\nУбрать ближайшее парковочное место\nПоставить продавца здесь\nУбрать продавца", "Poner el punto de compra aqui\nAnadir plaza aqui (el vehiculo en que estas o tu posicion)\nQuitar la plaza mas cercana\nPoner al vendedor aqui\nQuitar al vendedor", "Satin alma noktasini buraya koy\nBuraya park yeri ekle (bindiginiz arac veya konumunuz)\nEn yakin park yerini kaldir\nSaticiyi buraya koy\nSaticiyi kaldir" },
    { "Pijaca vec ima najvise mjesta.", "The market already has the maximum number of spots.", "На рынке уже максимум мест.", "El mercado ya tiene el maximo de plazas.", "Pazarda zaten en fazla yer var." },
    { "Parking mjesto je dodano.", "Parking spot added.", "Парковочное место добавлено.", "Plaza anadida.", "Park yeri eklendi." },
    { "Nema parking mjesta u blizini (10 m).", "No parking spot nearby (10 m).", "Рядом нет парковочного места (10 м).", "No hay plaza cerca (10 m).", "Yakinda park yeri yok (10 m)." },
    { "Parking mjesto je uklonjeno.", "Parking spot removed.", "Парковочное место убрано.", "Plaza quitada.", "Park yeri kaldirildi." },
    { "Pijaca se postavlja samo izvana.", "The market can only be placed outside.", "Рынок можно поставить только снаружи.", "El mercado solo se pone fuera.", "Pazar sadece disarida kurulabilir." },
    { "Mjesto otkupa je postavljeno.", "Buy-in point set.", "Точка выкупа поставлена.", "Punto de compra fijado.", "Satin alma noktasi ayarlandi." },
    { "  Auto pijaca: Y u svom vozilu kod otkupa (1/3 cijene), Y kod vozila na prodaji (kupnja)", "  Used car market: Y in your car at the buy-in point (1/3 of the price), Y at a car for sale (buy)", "  Авторынок: Y в своей машине у точки выкупа (1/3 цены), Y у машины на продаже (покупка)", "  Mercado de usados: Y en tu coche en el punto de compra (1/3 del precio), Y junto a un coche en venta (comprar)", "  Ikinci el pazari: satin alma noktasinda kendi aracinizda Y (fiyatin 1/3u), satilik aracin yaninda Y (satin al)" },
    { "Salter je uklonjen.", "Counter removed.", "Окно убрано.", "Ventanilla quitada.", "Gise kaldirildi." },
    { "Taj salter nije postavljen.", "That counter isn't placed.", "Это окно не поставлено.", "Esa ventanilla no esta colocada.", "Bu gise kurulmamis." },
    { "Prodavac", "Seller", "Продавец", "Vendedor", "Satici" },
    { "Dobar dan! Trazite dobar auto po povoljnoj cijeni?", "Good day! Looking for a good car at a fair price?", "Добрый день! Ищете хорошую машину по выгодной цене?", "Buenos dias! Buscas un buen coche a buen precio?", "Iyi gunler! Uygun fiyata iyi bir araba mi ariyorsunuz?" },
    { "Dobrodosli na auto pijacu! Sve sto vidite je na prodaju.", "Welcome to the used car market! Everything you see is for sale.", "Добро пожаловать на авторынок! Всё, что видите, продаётся.", "Bienvenido al mercado de usados! Todo lo que ves esta a la venta.", "Ikinci el pazarina hos geldiniz! Gordugunuz her sey satilik." },
    { "Hej, prijatelju! Imam auto bas za tebe.", "Hey, friend! I have just the car for you.", "Эй, друг! У меня есть машина как раз для тебя.", "Hola, amigo! Tengo el coche perfecto para ti.", "Hey dostum! Tam sana gore bir arabam var." },
    { "Hvala, ovaj ce se brzo prodati.", "Thanks, this one will sell fast.", "Спасибо, эта быстро продастся.", "Gracias, este se vendera rapido.", "Tesekkurler, bu hemen satilir." },
    { "Odlican izbor! Sretno na cesti.", "Great choice! Good luck on the road.", "Отличный выбор! Удачи на дороге.", "Excelente eleccion! Suerte en la carretera.", "Harika secim! Yolunuz acik olsun." },
    { "Prodavac stoji na vasem mjestu.", "The seller stands where you are.", "Продавец стоит на вашем месте.", "El vendedor esta donde estas tu.", "Satici sizin yerinizde duruyor." },
    { "Prodavac je uklonjen.", "Seller removed.", "Продавец убран.", "Vendedor quitado.", "Satici kaldirildi." },
    { "Prodavac nije postavljen.", "The seller isn't placed.", "Продавец не поставлен.", "El vendedor no esta colocado.", "Satici kurulmamis." },
    { "Vozac vas vise nece cekati, voznja je otkazana.", "The driver will not wait for you any longer, the ride is cancelled.", "Водитель больше не будет вас ждать, поездка отменена.", "El conductor ya no te esperara, el viaje se cancela.", "Sofor sizi artik beklemeyecek, yolculuk iptal edildi." },
    { "Lijep auto! Zanima li vas koliko vrijedi?", "Nice car! Want to know what it is worth?", "Красивая машина! Хотите узнать, сколько она стоит?", "Bonito coche! Quieres saber cuanto vale?", "Guzel araba! Ne kadar ettigini merak ediyor musunuz?" },
    { "Dobar dan! Mijenjate auto? Svratite do mene.", "Good day! Changing cars? Stop by.", "Добрый день! Меняете машину? Заезжайте ко мне.", "Buenos dias! Cambias de coche? Pasate por aqui.", "Iyi gunler! Araba mi degistiriyorsunuz? Bana ugrayin." },
    { "Hej, takav bi se kod mene brzo prodao!", "Hey, one like that would sell fast here!", "Эй, такая у меня быстро бы продалась!", "Oye, uno asi se venderia rapido aqui!", "Hey, boylesi bende hemen satilir!" },
    { "Vozila organizacija ne otkupljujem, zao mi je.", "I don't buy organisation vehicles, sorry.", "Машины организаций не выкупаю, извините.", "No compro vehiculos de organizaciones, lo siento.", "Organizasyon araclarini almiyorum, uzgunum." },
    { "Pijaca ne otkupljuje vozila organizacija.", "The market doesn't buy organisation vehicles.", "Рынок не выкупает машины организаций.", "El mercado no compra vehiculos de organizaciones.", "Pazar organizasyon araclarini almiyor." },
    { "Vozilo je vraceno: islo je brze nego sto moze.", "Vehicle reset: it went faster than it can.", "Транспорт возвращён: он ехал быстрее, чем может.", "Vehiculo reiniciado: iba mas rapido de lo que puede.", "Arac sifirlandi: gidebileceginden hizli gidiyordu." },
    { "[AC] %s vozi %s brzinom %d km/h (najvise %d). Vozilo je vraceno.", "[AC] %s drove a %s at %d km/h (max %d). Vehicle reset.", "[AC] %s ехал на %s со скоростью %d км/ч (макс. %d). Транспорт возвращён.", "[AC] %s conducia un %s a %d km/h (max %d). Vehiculo reiniciado.", "[AC] %s, %s aracini %d km/s hizla surdu (en fazla %d). Arac sifirlandi." },
