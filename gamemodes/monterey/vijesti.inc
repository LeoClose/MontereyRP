static const gReklamaBoja[] = { 0xFFC62828, 0xFF1565C0, 0xFF2E7D32, 0xFF6A1B9A, 0xFFEF6C00, 0xFF212121 };
static STREAMER_TAG_OBJECT:gPlocaObj[sizeof gPloca], STREAMER_TAG_OBJECT:gPlakatObj[sizeof gPlakat], gReklama[REKLAMA_MAX][REKLAMA_LEN + 1], gReklamaId[REKLAMA_MAX], gReklamaBr, gPlakatPomak, gPlakatSekunde, gVijestiOrg;

InitVijesti()
{
    DB_FreeResultSet(DB_ExecuteQuery(gDB, "CREATE TABLE IF NOT EXISTS lsn_clanci (id INTEGER PRIMARY KEY AUTOINCREMENT, account INTEGER NOT NULL, naslov TEXT NOT NULL, tekst TEXT NOT NULL, created INTEGER NOT NULL)"));
    DB_FreeResultSet(DB_ExecuteQuery(gDB, "CREATE TABLE IF NOT EXISTS lsn_reklame (id INTEGER PRIMARY KEY AUTOINCREMENT, account INTEGER NOT NULL, tekst TEXT NOT NULL, istek INTEGER NOT NULL)"));
    new DBResult:res = DB_ExecuteQuery(gDB, "SELECT id FROM orgs WHERE name = 'LS News'");
    gVijestiOrg = DB_GetRowCount(res) ? DB_GetFieldInt(res, 0) : 0;
    DB_FreeResultSet(res);
    ReklameUcitaj();
}

bool:VijestiClan(playerid)
{
    return gVijestiOrg && gOrg[playerid] == gVijestiOrg;
}

static bool:PlakatPokriven(model)
{
    return model == 1260 || model == 1267;
}

PlakatiUkloni(playerid)
{
    for (new b = 0; b < sizeof gPlakat; b++) if (!PlakatPokriven(gPlakat[b][plModel])) RemoveBuildingForPlayer(playerid, gPlakat[b][plModel], gPlakat[b][plX], gPlakat[b][plY], gPlakat[b][plZ], 0.5);
}

static bool:PlakatOkvir(model)
{
    return model == 1259 || model == 1260 || model == 1267 || model == 1309;
}

static PlakatVelicina(najduzi, redova, Float:sirina, visina)
{
    return clamp(min(floatround(800.0 * sirina / float(najduzi)), visina * 10 / (redova * 13)), 12, 90);
}

static PlakatiOsvjezi()
{
    new tekst[REKLAMA_LEN * 2 + 1], dodatak[REKLAMA_LEN + 1], najduzi[REKLAMA_MAX], redova[REKLAMA_MAX];
    for (new r = 0; r < gReklamaBr; r++)
    {
        new duz = 0;
        najduzi[r] = 1;
        redova[r] = 1;
        for (new i = 0; gReklama[r][i]; i++)
        {
            if (gReklama[r][i] == '|')
            {
                redova[r]++;
                duz = 0;
                continue;
            }
            if (++duz > najduzi[r]) najduzi[r] = duz;
        }
    }
    for (new b = 0; b < sizeof gPlakat; b++)
    {
        if (PlakatPokriven(gPlakat[b][plModel])) continue;
        if (!gReklamaBr || !IsValidDynamicObject(gPlakatObj[b]))
        {
            if (IsValidDynamicObject(gPlakatObj[b])) DestroyDynamicObject(gPlakatObj[b]);
            gPlakatObj[b] = CreateDynamicObject(gPlakat[b][plModel], gPlakat[b][plX], gPlakat[b][plY], gPlakat[b][plZ], 0.0, 0.0, gPlakat[b][plRz], -1, 0, -1, PLAKAT_DOMET, PLAKAT_DOMET);
        }
        if (!gReklamaBr) continue;
        new r = (b + gPlakatPomak) % gReklamaBr, boja = gReklamaBoja[gReklamaId[r] % sizeof gReklamaBoja];
        if (PlakatOkvir(gPlakat[b][plModel]))
        {
            SetDynamicObjectMaterialText(gPlakatObj[b], 0, " ", OBJECT_MATERIAL_SIZE_32x32, "Arial", 8, 0, 0, boja, _:OBJECT_MATERIAL_TEXT_ALIGN_CENTRE);
            continue;
        }
        for (new m = 0; m < 16; m++)
        {
            if (!(gPlakat[b][plMaska] & (1 << m))) continue;
            PlakatTekst(r, tekst, sizeof tekst);
            new n = redova[r];
            if (gPlakat[b][plPola] & (1 << m))
            {
                dodatak[0] = EOS;
                for (new k = 0; k < n; k++) strcat(dodatak, "\n ");
                strcat(tekst, dodatak);
                n *= 2;
            }
            SetDynamicObjectMaterialText(gPlakatObj[b], m, tekst, OBJECT_MATERIAL_SIZE_512x256, "Arial", PlakatVelicina(najduzi[r], n, 1.0, 256), 1, 0xFFFFFFFF, boja, _:OBJECT_MATERIAL_TEXT_ALIGN_CENTRE);
        }
    }
    for (new p = 0; p < sizeof gPloca; p++)
    {
        if (!gReklamaBr)
        {
            if (IsValidDynamicObject(gPlocaObj[p])) DestroyDynamicObject(gPlocaObj[p]);
            gPlocaObj[p] = STREAMER_TAG_OBJECT:0;
            continue;
        }
        if (!IsValidDynamicObject(gPlocaObj[p])) gPlocaObj[p] = CreateDynamicObject(gPloca[p][ppModel], gPloca[p][ppX], gPloca[p][ppY], gPloca[p][ppZ], 0.0, 0.0, gPloca[p][ppRz], -1, 0, -1, PLAKAT_DOMET, PLAKAT_DOMET);
        new r = (gPloca[p][ppPlakat] + gPlakatPomak) % gReklamaBr, bool:siroka = gPloca[p][ppModel] != 19479, pozadina = PlakatPokriven(gPlakat[gPloca[p][ppPlakat]][plModel]) ? gReklamaBoja[gReklamaId[r] % sizeof gReklamaBoja] : 0;
        PlakatTekst(r, tekst, sizeof tekst);
        SetDynamicObjectMaterialText(gPlocaObj[p], 0, tekst, siroka ? OBJECT_MATERIAL_SIZE_512x128 : OBJECT_MATERIAL_SIZE_512x256, "Arial", PlakatVelicina(najduzi[r], redova[r], gPloca[p][ppSirina] * 0.9, siroka ? 128 : 256), 1, 0xFFFFFFFF, pozadina, _:OBJECT_MATERIAL_TEXT_ALIGN_CENTRE);
    }
}

static PlakatTekst(r, tekst[], len)
{
    tekst[0] = EOS;
    strcat(tekst, gReklama[r], len);
    for (new i = 0; tekst[i]; i++) if (tekst[i] == '|') tekst[i] = '\n';
}

ReklameUcitaj()
{
    new sad = gettime();
    DB_FreeResultSet(DB_ExecuteQuery(gDB, "DELETE FROM lsn_reklame WHERE istek <= %d", sad));
    new DBResult:res = DB_ExecuteQuery(gDB, "SELECT id, tekst FROM lsn_reklame ORDER BY id LIMIT %d", REKLAMA_MAX);
    gReklamaBr = DB_GetRowCount(res);
    for (new r = 0; r < gReklamaBr; r++, DB_SelectNextRow(res))
    {
        gReklamaId[r] = DB_GetFieldInt(res, 0);
        DB_GetFieldString(res, 1, gReklama[r], REKLAMA_LEN + 1);
    }
    DB_FreeResultSet(res);
    PlakatiOsvjezi();
}

ReklameBroj()
{
    return gReklamaBr;
}

bool:ReklamaDodaj(playerid, const unos[])
{
    if (gReklamaBr >= REKLAMA_MAX || !unos[0]) return false;
    new tekst[REKLAMA_LEN + 1];
    strcat(tekst, unos);
    DB_FreeResultSet(DB_ExecuteQuery(gDB, "INSERT INTO lsn_reklame (account, tekst, istek) VALUES (%d, '%q', %d)", gAccountId[playerid], tekst, gettime() + REKLAMA_DANA * 86400));
    ReklameUcitaj();
    return true;
}

ReklamaObrisi(id)
{
    DB_FreeResultSet(DB_ExecuteQuery(gDB, "DELETE FROM lsn_reklame WHERE id = %d", id));
    ReklameUcitaj();
}

VijestiTick()
{
    if (++gPlakatSekunde < PLAKAT_ROTACIJA) return;
    gPlakatSekunde = 0;
    gPlakatPomak++;
    ReklameUcitaj();
}
