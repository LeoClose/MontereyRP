#define VRT_BOJA            0x27AE60FF
#define VRT_SAVJET_MS       3000

enum { VRP_NEMA, VRP_KOSNJA, VRP_VODA, VRP_OGRADA }
enum { VRA_NEMA, VRA_KOSILICA, VRA_CRIJEVO, VRA_CEKIC }

static const gVrtPosaoIme[][] = { "", "Kosnja trave", "Zalijevanje biljaka", "Popravak ograde" };
static const gVrtModelBiljke[] = { 948, 2001 };

static const Float:gVrtFlota[][4] = {
    { 1808.129, -2043.472, 13.490, 225.0 }, { 1811.240, -2040.361, 13.490, 225.0 }, { 1814.351, -2037.249, 13.490, 225.0 },
    { 1817.462, -2034.138, 13.490, 225.0 }, { 1820.574, -2031.027, 13.490, 225.0 }, { 1823.685, -2027.915, 13.490, 225.0 }
};
static Float:gVrtMjesto[4] = { 1819.796, -2039.583, 13.490, 225.0 }, bool:gVrtImaMjesto = true, STREAMER_TAG_3D_TEXT_LABEL:gVrtTekst;
static gVrtFlotaV[sizeof gVrtFlota], gVrtFlotaIgrac[sizeof gVrtFlota] = { -1, ... };
static gVrtZauzeta[sizeof gVrtKuca], bool:gVrtImaOgradu[sizeof gVrtKuca], STREAMER_TAG_OBJECT:gVrtOgradaObj[sizeof gVrtKuca][4];
static bool:gVrtSmjena[MAX_PLAYERS], gVrtKombi[MAX_PLAYERS], gVrtPosao[MAX_PLAYERS], gVrtKucaIgraca[MAX_PLAYERS] = { -1, ... }, gVrtGotovo[MAX_PLAYERS], gVrtSljedeci[MAX_PLAYERS];
static gVrtAlat[MAX_PLAYERS], gVrtKosilica[MAX_PLAYERS], gVrtZalij[MAX_PLAYERS][4], gVrtZadnjiTick[MAX_PLAYERS], gVrtSavjet[MAX_PLAYERS], gVrtZarada[MAX_PLAYERS];
static STREAMER_TAG_OBJECT:gVrtObj[MAX_PLAYERS][8], bool:gVrtStigao[MAX_PLAYERS];
static bool:gVrtIgra[MAX_PLAYERS], gVrtIgraSeg[MAX_PLAYERS], gVrtIgraPogodaka[MAX_PLAYERS], gVrtIgraTimer[MAX_PLAYERS], Float:gVrtTraka[MAX_PLAYERS], Float:gVrtSmjer[MAX_PLAYERS], Float:gVrtZel[MAX_PLAYERS];

InitVrtlar()
{
    DB_FreeResultSet(DB_ExecuteQuery(gDB, "CREATE TABLE IF NOT EXISTS job_lawn (id INTEGER PRIMARY KEY, x REAL NOT NULL, y REAL NOT NULL, z REAL NOT NULL, a REAL NOT NULL)"));
    DB_FreeResultSet(DB_ExecuteQuery(gDB, "CREATE TABLE IF NOT EXISTS lawn_fences (house INTEGER PRIMARY KEY)"));
    new DBResult:res = DB_ExecuteQuery(gDB, "SELECT x, y, z, a FROM job_lawn WHERE id = 1");
    if (DB_GetRowCount(res)) for (new k = 0; k < 4; k++) gVrtMjesto[k] = DB_GetFieldFloat(res, k);
    DB_FreeResultSet(res);
    for (new f = 0; f < sizeof gVrtFlota; f++) gVrtFlotaV[f] = CreateVehicle(VRT_KOMBI_MODEL, gVrtFlota[f][0], gVrtFlota[f][1], gVrtFlota[f][2], gVrtFlota[f][3], 44, 1, 600);
    for (new i = 0; i < MAX_PLAYERS; i++) gVrtKombi[i] = gVrtKosilica[i] = INVALID_VEHICLE_ID;
    for (new k = 0; k < sizeof gVrtKuca; k++)
    {
        gVrtZauzeta[k] = -1;
        for (new b = 0; b < gVrtKuca[k][vkBiljkeBr]; b++)
        {
            new p = gVrtKuca[k][vkBiljkeOd] + b;
            CreateDynamicObject(gVrtModelBiljke[(k + b) % sizeof gVrtModelBiljke], gVrtBiljka[p][0], gVrtBiljka[p][1], gVrtBiljka[p][2], 0.0, 0.0, float((k * 37 + b * 71) % 360), 0, 0);
        }
    }
    res = DB_ExecuteQuery(gDB, "SELECT house FROM lawn_fences");
    for (new r = 0, n = DB_GetRowCount(res); r < n; r++, DB_SelectNextRow(res))
    {
        new k = DB_GetFieldInt(res, 0);
        if (k < 0 || k >= sizeof gVrtKuca || !gVrtKuca[k][vkOgradaBr]) continue;
        gVrtImaOgradu[k] = true;
        for (new s = 0; s < gVrtKuca[k][vkOgradaBr]; s++) VrtSegmentStvori(k, s);
    }
    DB_FreeResultSet(res);
    VrtMjestoStvori();
}

static bool:VrtKombiZauzet(v)
{
    for (new i = 0, iZadnji = gIgracZadnji; i <= iZadnji; i++) if (IsPlayerConnected(i) && GetPlayerVehicleID(i) == v) return true;
    return false;
}

static VrtFlota(v)
{
    for (new f = 0; f < sizeof gVrtFlota; f++) if (gVrtFlotaV[f] == v) return f;
    return -1;
}

static VrtMjestoStvori()
{
    if (IsValidDynamic3DTextLabel(gVrtTekst)) DestroyDynamic3DTextLabel(gVrtTekst);
    gVrtImaMjesto = true;
    gVrtTekst = CreateDynamic3DTextLabel("Vrtlar\nALT", VRT_BOJA, gVrtMjesto[0], gVrtMjesto[1], gVrtMjesto[2] + 0.5, 10.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, 0, 0);
    InterakcijaOznaka(gVrtTekst, VRT_DOMET);
}

static VrtSegmentStvori(k, s)
{
    new p = gVrtKuca[k][vkOgradaOd] + s;
    if (_:gVrtOgradaObj[k][s]) DestroyDynamicObject(gVrtOgradaObj[k][s]);
    gVrtOgradaObj[k][s] = CreateDynamicObject(VRT_OGRADA_MODEL, gVrtOgrada[p][0], gVrtOgrada[p][1], gVrtOgrada[p][2], 0.0, 0.0, gVrtOgrada[p][3], 0, 0);
}

static VrtOgradaMakni(k)
{
    for (new s = 0; s < 4; s++)
    {
        if (_:gVrtOgradaObj[k][s]) DestroyDynamicObject(gVrtOgradaObj[k][s]);
        gVrtOgradaObj[k][s] = STREAMER_TAG_OBJECT:0;
    }
    if (gVrtImaOgradu[k]) DB_FreeResultSet(DB_ExecuteQuery(gDB, "DELETE FROM lawn_fences WHERE house = %d", k));
    gVrtImaOgradu[k] = false;
}

VrtCrijevo(playerid)
{
    return gVrtAlat[playerid] == VRA_CRIJEVO ? 1 : 0;
}

static bool:VrtNaMjestu(playerid, Float:r = VRT_DOMET)
{
    return gVrtImaMjesto && !GetPlayerInterior(playerid) && !GetPlayerVirtualWorld(playerid) && IsPlayerInRangeOfPoint(playerid, r, gVrtMjesto[0], gVrtMjesto[1], gVrtMjesto[2]);
}

static VrtStrag(v, &Float:x, &Float:y, &Float:z, Float:dalje = 0.6)
{
    new Float:a, Float:sx, Float:sy, Float:sz;
    GetVehiclePos(v, x, y, z);
    GetVehicleZAngle(v, a);
    GetVehicleModelInfo(GetVehicleModel(v), VEHICLE_MODEL_INFO_SIZE, sx, sy, sz);
    x += floatsin(a, degrees) * (sy / 2.0 + dalje);
    y -= floatcos(a, degrees) * (sy / 2.0 + dalje);
}

static bool:VrtIzaKombija(playerid)
{
    if (gVrtKombi[playerid] == INVALID_VEHICLE_ID || GetPlayerState(playerid) != PLAYER_STATE_ONFOOT) return false;
    new Float:x, Float:y, Float:z;
    VrtStrag(gVrtKombi[playerid], x, y, z);
    return IsPlayerInRangeOfPoint(playerid, VRT_STRAG_DOMET, x, y, z);
}

static VrtObjMakni(playerid)
{
    for (new o = 0; o < 8; o++)
    {
        if (_:gVrtObj[playerid][o]) DestroyDynamicObject(gVrtObj[playerid][o]);
        gVrtObj[playerid][o] = STREAMER_TAG_OBJECT:0;
    }
}

static VrtAlatVrati(playerid)
{
    switch (gVrtAlat[playerid])
    {
        case VRA_CRIJEVO: if (IsPlayerConnected(playerid)) RemovePlayerWeapon(playerid, WEAPON_FIREEXTINGUISHER);
        case VRA_CEKIC: if (IsPlayerConnected(playerid)) RemovePlayerAttachedObject(playerid, VRT_SLOT);
    }
    gVrtAlat[playerid] = VRA_NEMA;
    if (gVrtKosilica[playerid] != INVALID_VEHICLE_ID) DestroyVehicle(gVrtKosilica[playerid]);
    gVrtKosilica[playerid] = INVALID_VEHICLE_ID;
}

static VrtIgraKraj(playerid)
{
    if (!gVrtIgra[playerid]) return;
    gVrtIgra[playerid] = false;
    if (gVrtIgraTimer[playerid]) KillTimer(gVrtIgraTimer[playerid]);
    gVrtIgraTimer[playerid] = 0;
    if (!IsPlayerConnected(playerid)) return;
    IgraTdMakni(playerid);
    ClearAnimations(playerid, SYNC_ALL);
}

static VrtPosaoMakni(playerid, bool:gotov)
{
    VrtIgraKraj(playerid);
    VrtObjMakni(playerid);
    new k = gVrtKucaIgraca[playerid];
    if (k != -1)
    {
        if (gVrtPosao[playerid] == VRP_OGRADA && !gotov) VrtOgradaMakni(k);
        if (gVrtZauzeta[k] == playerid) gVrtZauzeta[k] = -1;
    }
    gVrtKucaIgraca[playerid] = -1;
    gVrtPosao[playerid] = VRP_NEMA;
    gVrtGotovo[playerid] = 0;
    gVrtStigao[playerid] = false;
    if (IsPlayerConnected(playerid))
    {
        DisablePlayerCheckpoint(playerid);
        IgraObavijestUkloni(playerid);
    }
}

VrtlarKraj(playerid)
{
    if (!gVrtSmjena[playerid]) return;
    VrtPosaoMakni(playerid, false);
    VrtAlatVrati(playerid);
    gVrtSmjena[playerid] = false;
    new f = VrtFlota(gVrtKombi[playerid]);
    if (f != -1)
    {
        gVrtFlotaIgrac[f] = -1;
        SetVehicleToRespawn(gVrtKombi[playerid]);
    }
    gVrtKombi[playerid] = INVALID_VEHICLE_ID;
}

static VrtBroj(playerid)
{
    new k = gVrtKucaIgraca[playerid];
    switch (gVrtPosao[playerid])
    {
        case VRP_KOSNJA: return gVrtKuca[k][vkTravaBr];
        case VRP_VODA: return gVrtKuca[k][vkBiljkeBr];
        case VRP_OGRADA: return gVrtKuca[k][vkOgradaBr];
    }
    return 0;
}

static VrtGotovoBroj(playerid)
{
    new n = 0;
    for (new b = 0; b < 8; b++) if (gVrtGotovo[playerid] >> b & 1) n++;
    return n;
}

static VrtPanel(playerid)
{
    new poruka[256], k = gVrtKucaIgraca[playerid];
    if (k == -1)
    {
        IgraObavijestPanel(playerid, T(playerid, "Vrtlar"), VRT_BOJA, T(playerid, "Cekate poziv klijenta..."));
        return;
    }
    new alat[64];
    switch (gVrtPosao[playerid])
    {
        case VRP_KOSNJA: format(alat, sizeof alat, T(playerid, "Pokosite travu kosilicom iz kombija."));
        case VRP_VODA: format(alat, sizeof alat, T(playerid, "Zalijte biljke crijevom iz kombija."));
        default: format(alat, sizeof alat, T(playerid, "Postavite ogradu cekicem iz kombija."));
    }
    format(poruka, sizeof poruka, T(playerid, "%s - %s~n~%s~n~Napredak: %d/%d"), T(playerid, gVrtPosaoIme[gVrtPosao[playerid]]), CestaZona(gVrtKuca[k][vkX], gVrtKuca[k][vkY]), alat, VrtGotovoBroj(playerid), VrtBroj(playerid));
    IgraObavijestPanel(playerid, T(playerid, "Vrtlar"), VRT_BOJA, poruka);
}

static VrtNoviPosao(playerid)
{
    new kandidati[sizeof gVrtKuca], n = 0, tip, r = random(100);
    tip = r < 45 ? VRP_KOSNJA : r < 70 ? VRP_VODA : VRP_OGRADA;
    for (new pokusaj = 0; pokusaj < 3 && !n; pokusaj++)
    {
        for (new k = 0; k < sizeof gVrtKuca; k++)
        {
            if (gVrtZauzeta[k] != -1) continue;
            if ((tip == VRP_KOSNJA && gVrtKuca[k][vkTravaBr] >= 4) || (tip == VRP_VODA && gVrtKuca[k][vkBiljkeBr]) || (tip == VRP_OGRADA && gVrtKuca[k][vkOgradaBr] >= 2)) kandidati[n++] = k;
        }
        if (!n) tip = tip % 3 + 1;
    }
    if (!n)
    {
        gVrtSljedeci[playerid] = gettime() + VRT_POZIV_MIN;
        return;
    }
    new k = kandidati[random(n)];
    gVrtZauzeta[k] = playerid;
    gVrtKucaIgraca[playerid] = k;
    gVrtPosao[playerid] = tip;
    gVrtGotovo[playerid] = 0;
    gVrtStigao[playerid] = false;
    for (new b = 0; b < 4; b++) gVrtZalij[playerid][b] = 0;
    new Float:cx, Float:cy, Float:cz;
    switch (tip)
    {
        case VRP_KOSNJA:
        {
            for (new t = 0; t < gVrtKuca[k][vkTravaBr]; t++)
            {
                new p = gVrtKuca[k][vkTravaOd] + t;
                gVrtObj[playerid][t] = CreateDynamicObject(VRT_GRANA_MODEL, gVrtTrava[p][0], gVrtTrava[p][1], gVrtTrava[p][2], 0.0, 0.0, float(random(360)), 0, 0, playerid);
            }
            new p = gVrtKuca[k][vkTravaOd];
            cx = gVrtTrava[p][0], cy = gVrtTrava[p][1], cz = gVrtTrava[p][2];
        }
        case VRP_VODA:
        {
            for (new b = 0; b < gVrtKuca[k][vkBiljkeBr]; b++)
            {
                new p = gVrtKuca[k][vkBiljkeOd] + b;
                gVrtObj[playerid][b] = CreateDynamicObject(VRT_OZNAKA_MODEL, gVrtBiljka[p][0], gVrtBiljka[p][1], gVrtBiljka[p][2] + 2.2, 0.0, 0.0, 0.0, 0, 0, playerid);
            }
            new p = gVrtKuca[k][vkBiljkeOd];
            cx = gVrtBiljka[p][0], cy = gVrtBiljka[p][1], cz = gVrtBiljka[p][2];
        }
        default:
        {
            VrtOgradaMakni(k);
            for (new s = 0; s < gVrtKuca[k][vkOgradaBr]; s++)
            {
                new p = gVrtKuca[k][vkOgradaOd] + s;
                gVrtObj[playerid][s] = CreateDynamicObject(VRT_OZNAKA_MODEL, gVrtOgrada[p][0], gVrtOgrada[p][1], gVrtOgrada[p][2] + 1.4, 0.0, 0.0, 0.0, 0, 0, playerid);
            }
            new p = gVrtKuca[k][vkOgradaOd];
            cx = gVrtOgrada[p][0], cy = gVrtOgrada[p][1], cz = gVrtOgrada[p][2];
        }
    }
    SetPlayerCheckpoint(playerid, cx, cy, cz, 3.0);
    new poruka[160], broj[12];
    format(broj, sizeof broj, "555%04d", 1000 + random(9000));
    switch (tip)
    {
        case VRP_KOSNJA: format(poruka, sizeof poruka, T(playerid, "Pozdrav, trebam pokositi travnjak ispred kuce. Adresa: %s."), CestaZona(gVrtKuca[k][vkX], gVrtKuca[k][vkY]));
        case VRP_VODA: format(poruka, sizeof poruka, T(playerid, "Pozdrav, mozete li mi zaliti biljke ispred kuce? Adresa: %s."), CestaZona(gVrtKuca[k][vkX], gVrtKuca[k][vkY]));
        default: format(poruka, sizeof poruka, T(playerid, "Pozdrav, ograda mi se raspala, mozete li postaviti novu? Adresa: %s."), CestaZona(gVrtKuca[k][vkX], gVrtKuca[k][vkY]));
    }
    MobitelPrimiPoruku(gAccountId[playerid], broj, poruka);
    IgraObavijest(playerid, T(playerid, "Novi poziv"), VRT_BOJA, poruka, 6000);
    PlayerPlaySound(playerid, 1149, 0.0, 0.0, 0.0);
}

static VrtDovrsi(playerid)
{
    new k = gVrtKucaIgraca[playerid], tip = gVrtPosao[playerid], iznos = tip == VRP_KOSNJA ? VRT_PLACA_KOSNJA : tip == VRP_VODA ? VRT_PLACA_VODA : VRT_PLACA_OGRADA, poruka[160];
    if (tip == VRP_OGRADA)
    {
        gVrtImaOgradu[k] = true;
        DB_FreeResultSet(DB_ExecuteQuery(gDB, "INSERT OR IGNORE INTO lawn_fences (house) VALUES (%d)", k));
    }
    VrtPosaoMakni(playerid, true);
    if (gVrtAlat[playerid] != VRA_KOSILICA) VrtAlatVrati(playerid);
    iznos = BlagajnaIsplati(iznos);
    if (!DajNovac(playerid, iznos)) BlagajnaDodaj(iznos), iznos = 0;
    gVrtZarada[playerid] += iznos;
    format(poruka, sizeof poruka, T(playerid, "Posao je gotov, klijent je zadovoljan! +$%d~n~Zarada ove smjene: $%d~n~Pricekajte novi poziv."), iznos, gVrtZarada[playerid]);
    IgraObavijest(playerid, T(playerid, "Vrtlar"), VRT_BOJA, poruka, 6000);
    PlayerPlaySound(playerid, 1058, 0.0, 0.0, 0.0);
    gVrtSljedeci[playerid] = gettime() + VRT_POZIV_MIN + random(VRT_POZIV_RASPON);
}

static VrtOznaci(playerid, b)
{
    gVrtGotovo[playerid] |= 1 << b;
    if (_:gVrtObj[playerid][b]) DestroyDynamicObject(gVrtObj[playerid][b]);
    gVrtObj[playerid][b] = STREAMER_TAG_OBJECT:0;
    if (VrtGotovoBroj(playerid) >= VrtBroj(playerid)) VrtDovrsi(playerid);
    else VrtPanel(playerid);
}

static VrtPocni(playerid)
{
    new f = -1, Float:najblize = 0.0;
    for (new k = 0; k < sizeof gVrtFlota; k++)
    {
        new Float:hp;
        GetVehicleHealth(gVrtFlotaV[k], hp);
        if (gVrtFlotaIgrac[k] != -1 || hp < VRT_KOMBI_HP || VrtKombiZauzet(gVrtFlotaV[k])) continue;
        new Float:d = GetPlayerDistanceFromPoint(playerid, gVrtFlota[k][0], gVrtFlota[k][1], gVrtFlota[k][2]);
        if (f == -1 || d < najblize) f = k, najblize = d;
    }
    if (f == -1) return ObavijestGreska(playerid, T(playerid, "Trenutno nema slobodnih kombija.")), 1;
    new v = gVrtFlotaV[f];
    gVrtFlotaIgrac[f] = playerid;
    VoziloNapuni(v);
    gVrtKombi[playerid] = v;
    gVrtSmjena[playerid] = true;
    gVrtZarada[playerid] = 0;
    gVrtSavjet[playerid] = 0;
    gVrtSljedeci[playerid] = gettime() + 5;
    PutPlayerInVehicle(playerid, v, 0);
    VoziloSet(v, VP_MOTOR, 1);
    VrtPanel(playerid);
    Savjet(playerid, T(playerid, "Klijenti vas zovu na mobitel~n~Kod kuce izadite i pritisnite ~y~ALT~w~ iza kombija za alat~n~~y~/posao~w~ - kraj smjene"), 8000);
    return 1;
}

static VrtAlatUzmi(playerid)
{
    if (gVrtAlat[playerid] != VRA_NEMA)
    {
        VrtAlatVrati(playerid);
        return ObavijestInfo(playerid, T(playerid, "Vrtlar"), T(playerid, "Vratili ste alat u kombi.")), 1;
    }
    if (gVrtPosao[playerid] == VRP_NEMA) return ObavijestGreska(playerid, T(playerid, "Nemate posao. Pricekajte poziv klijenta.")), 1;
    switch (gVrtPosao[playerid])
    {
        case VRP_KOSNJA:
        {
            new Float:x, Float:y, Float:z, Float:a;
            VrtStrag(gVrtKombi[playerid], x, y, z, 2.6);
            GetVehicleZAngle(gVrtKombi[playerid], a);
            new v = CreateVehicle(VRT_KOSILICA_MODEL, x, y, z, a, 44, 1, -1);
            if (v == INVALID_VEHICLE_ID) return ObavijestGreska(playerid, T(playerid, "Kosilica trenutno nije dostupna.")), 1;
            VoziloNapuni(v);
            gVrtKosilica[playerid] = v;
            gVrtAlat[playerid] = VRA_KOSILICA;
            PutPlayerInVehicle(playerid, v, 0);
            VoziloSet(v, VP_MOTOR, 1);
            Savjet(playerid, T(playerid, "Provozajte kosilicu preko sve trave u dvoristu~n~Kosilicu vratite s ~y~ALT~w~ iza kombija"), 6000);
        }
        case VRP_VODA:
        {
            gVrtAlat[playerid] = VRA_CRIJEVO;
            GivePlayerWeapon(playerid, WEAPON_FIREEXTINGUISHER, 5000);
            SetPlayerArmedWeapon(playerid, WEAPON_FIREEXTINGUISHER);
            Savjet(playerid, T(playerid, "Stanite kraj biljke, okrenite se prema njoj~n~i drzite ~y~~k~~PED_FIREWEAPON~~w~ dok se ne zalije"), 6000);
        }
        default:
        {
            gVrtAlat[playerid] = VRA_CEKIC;
            SetPlayerAttachedObject(playerid, VRT_SLOT, VRT_CEKIC_MODEL, 6, 0.08, 0.02, 0.0, 0.0, 0.0, 0.0);
            Savjet(playerid, T(playerid, "Pridite oznaci ograde i pritisnite ~y~ALT~w~~n~Zabijte cavle: ~y~SPACE~w~ kad je oznaka u zelenom"), 6000);
        }
    }
    PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);
    return 1;
}

static VrtSegmentBlizu(playerid)
{
    new k = gVrtKucaIgraca[playerid];
    if (k == -1 || gVrtPosao[playerid] != VRP_OGRADA) return -1;
    for (new s = 0; s < gVrtKuca[k][vkOgradaBr]; s++)
    {
        if (gVrtGotovo[playerid] >> s & 1) continue;
        new p = gVrtKuca[k][vkOgradaOd] + s;
        if (IsPlayerInRangeOfPoint(playerid, VRT_SEGMENT_DOMET, gVrtOgrada[p][0], gVrtOgrada[p][1], gVrtOgrada[p][2])) return s;
    }
    return -1;
}

static VrtIgraPanel(playerid)
{
    new uputa[128];
    format(uputa, sizeof uputa, T(playerid, "Zabijte cavao: ~y~SPACE~w~ kad je oznaka u zelenom (%d/%d)."), gVrtIgraPogodaka[playerid], VRT_CAVLI);
    IgraPanel(playerid, T(playerid, "Ograda"), 60.0, VRT_BOJA);
    IgraTraka(playerid, gVrtZel[playerid], gVrtZel[playerid] + VRT_TRAKA_ZELENO, 0x6E4B2AFF, 0x27AE60FF, 0x6E4B2AFF, uputa);
    IgraOznakaPomakni(playerid, gVrtTraka[playerid]);
}

static VrtGradi(playerid, s)
{
    new k = gVrtKucaIgraca[playerid], p = gVrtKuca[k][vkOgradaOd] + s, Float:px, Float:py, Float:pz;
    GetPlayerPos(playerid, px, py, pz);
    SetPlayerFacingAngle(playerid, atan2(-(gVrtOgrada[p][0] - px), gVrtOgrada[p][1] - py));
    ApplyAnimation(playerid, "CAR", "Fixn_Car_Loop", 4.1, true, false, false, false, 0, SYNC_ALL);
    gVrtIgra[playerid] = true;
    gVrtIgraSeg[playerid] = s;
    gVrtIgraPogodaka[playerid] = 0;
    gVrtTraka[playerid] = 0.0;
    gVrtSmjer[playerid] = 2.6;
    gVrtZel[playerid] = float(15 + random(65));
    VrtIgraPanel(playerid);
    gVrtIgraTimer[playerid] = SetTimerEx("VrtTrakaKorak", VRT_TRAKA_MS, true, "i", playerid);
    return 1;
}

forward VrtTrakaKorak(playerid);
public VrtTrakaKorak(playerid)
{
    if (!gVrtIgra[playerid]) return;
    gVrtTraka[playerid] += gVrtSmjer[playerid];
    if (gVrtTraka[playerid] >= 100.0 || gVrtTraka[playerid] <= 0.0) gVrtSmjer[playerid] = -gVrtSmjer[playerid];
    IgraOznakaPomakni(playerid, gVrtTraka[playerid]);
}

bool:VrtlarKey(playerid, KEY:newkeys, KEY:oldkeys)
{
    if (!gVrtIgra[playerid]) return false;
    if (!(newkeys & KEY_SPRINT) || (oldkeys & KEY_SPRINT)) return true;
    new bool:pogodak = gVrtTraka[playerid] >= gVrtZel[playerid] && gVrtTraka[playerid] <= gVrtZel[playerid] + VRT_TRAKA_ZELENO;
    PlayerPlaySound(playerid, pogodak ? 1056 : 1055, 0.0, 0.0, 0.0);
    if (!pogodak)
    {
        gVrtIgraPogodaka[playerid] = 0;
        IgraObavijest(playerid, T(playerid, "Vrtlar"), OBAVIJEST_GRESKA, T(playerid, "Promasili ste cavao! Krenite ispocetka s ovim dijelom."));
    }
    else if (++gVrtIgraPogodaka[playerid] >= VRT_CAVLI)
    {
        new k = gVrtKucaIgraca[playerid], s = gVrtIgraSeg[playerid];
        VrtIgraKraj(playerid);
        VrtSegmentStvori(k, s);
        VrtOznaci(playerid, s);
        return true;
    }
    gVrtZel[playerid] = float(15 + random(65));
    VrtIgraPanel(playerid);
    return true;
}

VrtlarUpdate(playerid)
{
    if (!gVrtSmjena[playerid] || gVrtKucaIgraca[playerid] == -1) return;
    new k = gVrtKucaIgraca[playerid], sad = GetTickCount();
    if (gVrtPosao[playerid] == VRP_KOSNJA && gVrtKosilica[playerid] != INVALID_VEHICLE_ID && GetPlayerVehicleID(playerid) == gVrtKosilica[playerid])
    {
        new Float:x, Float:y, Float:z;
        GetVehiclePos(gVrtKosilica[playerid], x, y, z);
        for (new t = 0; t < gVrtKuca[k][vkTravaBr]; t++)
        {
            if (gVrtGotovo[playerid] >> t & 1) continue;
            new p = gVrtKuca[k][vkTravaOd] + t;
            if (VectorSize(x - gVrtTrava[p][0], y - gVrtTrava[p][1], 0.0) > VRT_TRAVA_DOMET || floatabs(z - gVrtTrava[p][2]) > 2.5) continue;
            PlayerPlaySound(playerid, 1056, 0.0, 0.0, 0.0);
            VrtOznaci(playerid, t);
            break;
        }
        return;
    }
    if (gVrtPosao[playerid] != VRP_VODA || gVrtAlat[playerid] != VRA_CRIJEVO) return;
    new proslo = sad - gVrtZadnjiTick[playerid];
    gVrtZadnjiTick[playerid] = sad;
    if (proslo > 200) proslo = 200;
    new KEY:tipke, gd, lr;
    GetPlayerKeys(playerid, tipke, gd, lr);
    if (!(tipke & KEY_FIRE) || GetPlayerWeapon(playerid) != WEAPON_FIREEXTINGUISHER) return;
    new Float:px, Float:py, Float:pz, Float:a;
    GetPlayerPos(playerid, px, py, pz);
    GetPlayerFacingAngle(playerid, a);
    for (new b = 0; b < gVrtKuca[k][vkBiljkeBr]; b++)
    {
        if (gVrtGotovo[playerid] >> b & 1) continue;
        new p = gVrtKuca[k][vkBiljkeOd] + b, Float:dx = gVrtBiljka[p][0] - px, Float:dy = gVrtBiljka[p][1] - py;
        if (VectorSize(dx, dy, 0.0) > VRT_BILJKA_DOMET) continue;
        new Float:r = floatabs(atan2(-dx, dy) - a);
        while (r > 180.0) r = floatabs(r - 360.0);
        if (r > 50.0) continue;
        gVrtZalij[playerid][b] += proslo;
        if (gVrtZalij[playerid][b] >= VRT_ZALIJ_MS)
        {
            PlayerPlaySound(playerid, 1056, 0.0, 0.0, 0.0);
            VrtOznaci(playerid, b);
        }
        return;
    }
}

VrtlarAlt(playerid)
{
    if (!gUlogiran[playerid] || GetPlayerState(playerid) != PLAYER_STATE_ONFOOT || IsRanjen(playerid)) return 0;
    if (gVrtSmjena[playerid])
    {
        if (gVrtIgra[playerid]) return 1;
        if (gVrtAlat[playerid] == VRA_CEKIC)
        {
            new s = VrtSegmentBlizu(playerid);
            if (s != -1) return VrtGradi(playerid, s);
        }
        if (VrtIzaKombija(playerid)) return VrtAlatUzmi(playerid);
    }
    if (!VrtNaMjestu(playerid)) return 0;
    if (!gVrtSmjena[playerid]) return UpitDaNe(playerid, UPIT_VRTLAR, 0, 1, T(playerid, "Vrtlar"), T(playerid, "Zelite li zapoceti smjenu?")), 1;
    return UpitDaNe(playerid, UPIT_VRTLAR, 0, 2, T(playerid, "Vrtlar"), T(playerid, "Zelite li zavrsiti smjenu?")), 1;
}

VrtlarUpit(playerid, opcija, bool:da)
{
    if (!da || !VrtNaMjestu(playerid, VRT_DOMET + 2.0)) return 1;
    if (opcija == 1 && !gVrtSmjena[playerid]) return VrtPocni(playerid);
    if (opcija == 2 && gVrtSmjena[playerid])
    {
        VrtlarKraj(playerid);
        return ObavijestInfo(playerid, T(playerid, "Vrtlar"), T(playerid, "Smjena je zavrsena."));
    }
    return 1;
}

VrtlarPosao(playerid)
{
    if (gVrtSmjena[playerid])
    {
        VrtlarKraj(playerid);
        return ObavijestInfo(playerid, T(playerid, "Vrtlar"), T(playerid, "Smjena je zavrsena.")), 1;
    }
    if (GetPlayerState(playerid) != PLAYER_STATE_ONFOOT || !VrtNaMjestu(playerid)) return 0;
    return UpitDaNe(playerid, UPIT_VRTLAR, 0, 1, T(playerid, "Vrtlar"), T(playerid, "Zelite li zapoceti smjenu?")), 1;
}

VrtlarStateChange(playerid, PLAYER_STATE:newstate)
{
    if (newstate != PLAYER_STATE_DRIVER && newstate != PLAYER_STATE_PASSENGER) return;
    new v = GetPlayerVehicleID(playerid);
    for (new i = 0, iZadnji = gIgracZadnji; i <= iZadnji; i++)
    {
        if (!gVrtSmjena[i] || i == playerid) continue;
        if (v == gVrtKombi[i] || v == gVrtKosilica[i])
        {
            RemovePlayerFromVehicle(playerid);
            return;
        }
    }
    if (VrtFlota(v) != -1 && gVrtKombi[playerid] != v)
    {
        RemovePlayerFromVehicle(playerid);
        ObavijestGreska(playerid, T(playerid, "Kombi je samo za vrtlare na smjeni. Smjenu pocinjete s ALT kod vrtlara."));
    }
}

static bool:VrtKosilicaDaleko(playerid)
{
    new Float:x, Float:y, Float:z;
    GetVehiclePos(gVrtKosilica[playerid], x, y, z);
    return !IsPlayerInRangeOfPoint(playerid, VRT_KOSILICA_DALEKO, x, y, z);
}

VrtlarTick()
{
    new sad = gettime();
    for (new i = 0, iZadnji = gIgracZadnji; i <= iZadnji; i++)
    {
        if (!gVrtSmjena[i]) continue;
        new v = gVrtKombi[i], Float:hp;
        GetVehicleHealth(v, hp);
        if (!IsPlayerConnected(i) || IsRanjen(i) || !GetVehicleModel(v) || hp < VRT_KOMBI_HP)
        {
            VrtlarKraj(i);
            if (IsPlayerConnected(i)) ObavijestGreska(i, T(i, "Kombi je unisten, smjena je zavrsena."));
            continue;
        }
        if (gVrtKosilica[i] != INVALID_VEHICLE_ID && (!GetVehicleModel(gVrtKosilica[i]) || (GetPlayerVehicleID(i) != gVrtKosilica[i] && VrtKosilicaDaleko(i))))
        {
            DestroyVehicle(gVrtKosilica[i]);
            gVrtKosilica[i] = INVALID_VEHICLE_ID;
            if (gVrtAlat[i] == VRA_KOSILICA) gVrtAlat[i] = VRA_NEMA;
        }
        if (gVrtKucaIgraca[i] == -1)
        {
            if (sad >= gVrtSljedeci[i]) VrtNoviPosao(i);
            if (gVrtKucaIgraca[i] == -1 && !IgraObavijestVidljiva(i)) VrtPanel(i);
        }
        else
        {
            new k = gVrtKucaIgraca[i];
            if (!gVrtStigao[i] && IsPlayerInRangeOfPoint(i, VRT_STIGAO, gVrtKuca[k][vkX], gVrtKuca[k][vkY], gVrtKuca[k][vkZ]))
            {
                gVrtStigao[i] = true;
                DisablePlayerCheckpoint(i);
            }
            if (!IgraObavijestVidljiva(i)) VrtPanel(i);
        }
        new savjet = 0;
        if (!gVrtIgra[i])
        {
            if (VrtIzaKombija(i)) savjet = gVrtAlat[i] != VRA_NEMA ? 4 : gVrtPosao[i];
            else if (gVrtAlat[i] == VRA_CEKIC && VrtSegmentBlizu(i) != -1) savjet = 5;
        }
        if (savjet != gVrtSavjet[i] && savjet)
        {
            switch (savjet)
            {
                case VRP_KOSNJA: Savjet(i, T(i, "~y~ALT~w~ - uzmi kosilicu"), VRT_SAVJET_MS);
                case VRP_VODA: Savjet(i, T(i, "~y~ALT~w~ - uzmi crijevo"), VRT_SAVJET_MS);
                case VRP_OGRADA: Savjet(i, T(i, "~y~ALT~w~ - uzmi cekic"), VRT_SAVJET_MS);
                case 4: Savjet(i, T(i, "~y~ALT~w~ - vrati alat u kombi"), VRT_SAVJET_MS);
                default: Savjet(i, T(i, "~y~ALT~w~ - postavi dio ograde"), VRT_SAVJET_MS);
            }
        }
        gVrtSavjet[i] = savjet;
    }
}

ShowVrtlarAdmin(playerid)
{
    new list[256], len = 0;
    DodajStupac(list, len, T(playerid, "{8AB4F8}+ Vrtlar mjesto na mojoj poziciji"));
    return PrikaziDialog(playerid, DLG_APANEL_VRTLAR, DIALOG_STYLE_LIST, T(playerid, "Vrtlar"), list, T(playerid, "Odaberi"), T(playerid, "Natrag"));
}

DLG:apanel_vrtlar(playerid, response, listitem)
{
    if (!response) return ShowKategoriju(playerid);
    if (!ProvjeriOvlasti(playerid, ALVL_ORG) || listitem != 0) return 1;
    if (GetPlayerInterior(playerid) || GetPlayerVirtualWorld(playerid)) return ObavijestGreska(playerid, T(playerid, "Ovo se postavlja samo izvana.")), ShowVrtlarAdmin(playerid);
    new Float:x, Float:y, Float:z, Float:a, v = GetPlayerVehicleID(playerid);
    if (v) GetVehiclePos(v, x, y, z), GetVehicleZAngle(v, a);
    else GetPlayerPos(playerid, x, y, z), GetPlayerFacingAngle(playerid, a);
    DB_FreeResultSet(DB_ExecuteQuery(gDB, "INSERT OR REPLACE INTO job_lawn (id, x, y, z, a) VALUES (1, %f, %f, %f, %f)", x, y, z, a));
    gVrtMjesto[0] = x, gVrtMjesto[1] = y, gVrtMjesto[2] = z, gVrtMjesto[3] = a;
    VrtMjestoStvori();
    SendClientMessage(playerid, COLOR_ADMIN, T(playerid, "Vrtlar mjesto postavljeno."));
    return ShowVrtlarAdmin(playerid);
}
